 "cards": [
  {
   "dot": "amber",
   "title": "How to read",
   "items": [
    "Solid arrows: forward pass and reconstructed features (FAKE pass)",
    "Dashed arrows: real features sent straight to the discriminator (REAL pass)",
    "Each head classifies its input as real or reconstructed"
   ]
  },
  {
   "dot": "cyan",
   "title": "Discriminator heads",
   "items": [
    "Log and metric: 1D CNN, then linear",
    "Async count, async order, trace structure: 1-layer GAT, then linear",
    "Both attribute heads: MLP over the service mean"
   ]
  },
  {
   "dot": "rose",
   "title": "Opt-in branches",
   "items": [
    "open_trace adds the trace band, open_async_trace the async band",
    "Order decoder and its head need async_order",
    "Async errors add to the fused score; RCA uses sync node scores"
   ]
  }
 ]
}