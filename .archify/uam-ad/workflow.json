  "cards": [
    {
      "dot": "emerald",
      "title": "What it achieves",
      "items": [
        "No labeled incidents needed: it learns from healthy runs only",
        "Reads all four signals together, including async queue messages",
        "Answers both \"is something wrong?\" and \"which services first?\""
      ]
    },
    {
      "dot": "violet",
      "title": "The core idea",
      "items": [
        "A model that has only seen healthy traffic redraws healthy snapshots well",
        "When something breaks, the redraw no longer matches reality",
        "The bigger the mismatch, the more likely an incident"
      ]
    },
    {
      "dot": "slate",
      "title": "If an ML person asks",
      "items": [
        "Redraw model = generator (reconstruction model)",
        "Judge = discriminator, used only while training",
        "Mismatch score = reconstruction error; alarm line = p95 on normal validation data"
      ]
    }
  ]
